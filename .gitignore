# ========================================
# CliniXAI — .gitignore
# ========================================

# ── Environment & Secrets ──────────────
.env
.env.local
.env.production
backend/.env
backend/.env.local
frontend/.env
clinixai-health-flow/.env
clinixai-health-flow/.env.local

# ── Python ────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/

# ── Python virtual environments ───────
venv/
.venv/
env/

# ── pytest / coverage ─────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Node / Frontend ───────────────────
node_modules/
clinixai-health-flow/node_modules/
.output/
.wrangler/

# ── AI / ML model artifacts ───────────
*.keras
*.h5
*.pt
*.onnx
ai_models/

# ── Uploads ───────────────────────────
uploads/

# ── IDE / OS ──────────────────────────
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────
*.log
logs/
