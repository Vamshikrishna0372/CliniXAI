# =====================================================
# CliniXAI Backend — .env.example
# Copy this to .env and fill in your actual values.
# NEVER commit the real .env file with secrets.
# =====================================================

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME="CliniXAI API"
APP_VERSION="1.0.0"
ENVIRONMENT=development          # development | production | test
DEBUG=true
API_V1_PREFIX="/api/v1"

# ── Database ────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017      # MongoDB Atlas URI in production
MONGODB_DB_NAME=clinixai

# ── Security & CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000
# Production: CORS_ORIGINS=https://your-app.vercel.app

# ── JWT Authentication ───────────────────────────────────────────────────────────
# CRITICAL: Replace with a long random secret in production
JWT_SECRET_KEY=change_this_to_a_long_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
VERIFICATION_TOKEN_EXPIRE_HOURS=24
RESET_TOKEN_EXPIRE_HOURS=1

# ── Google OAuth 2.0 / OpenID Connect ────────────────────────────────────────────
# One Google Cloud Project "CliniXAI" can serve both Sign-In and Calendar.
# Set GOOGLE_AUTH_ENABLED=true only after configuring credentials.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# ── Google Calendar (Incremental Authorization) ───────────────────────────────────
# Requested ONLY when user explicitly clicks "Add to Google Calendar".
# Does NOT require separate Google Cloud project from Sign-In.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5173/calendar/callback

# ── Email Service ────────────────────────────────────────────────────────────────
# Set EMAIL_ENABLED=true and provide SMTP credentials for live delivery.
# When disabled, emails are logged safely (no-op — does not block operations).
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CliniXAI
SMTP_USE_TLS=true

# ── Object Storage ────────────────────────────────────────────────────────────────
# STORAGE_PROVIDER: "local" for development, "object" or "s3" for production.
# Medical files should NEVER live on Render's ephemeral local filesystem in production.
STORAGE_PROVIDER=local
UPLOAD_ROOT=uploads
MAX_UPLOAD_SIZE_MB=10

# Production S3-compatible object storage credentials (only required when STORAGE_PROVIDER=object):
STORAGE_BUCKET_NAME=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# ── Hospital Location & Free-First Maps ──────────────────────────────────────────
# No Google Maps Platform API key is required. Uses a simple directions URL.
HOSPITAL_NAME=CliniXAI Multi-Specialty Hospital & Research Center
HOSPITAL_ADDRESS=100 Healthcare Boulevard, Medical District, Tech City
HOSPITAL_DIRECTIONS_URL=https://maps.google.com/?q=Your+Hospital+Address

# ── Rate Limiting ─────────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_GENERAL_PER_MINUTE=60

# ── AI Subsystem ──────────────────────────────────────────────────────────────────
AI_ENABLED=true
AI_MODEL_PATH=ai_models/model.keras
AI_METADATA_PATH=ai_models/model_metadata.json
AI_CLASS_MAP_PATH=ai_models/class_names.json
AI_GRADCAM_LAYER=conv5_block3_out

# ── Logging ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO    # DEBUG | INFO | WARNING | ERROR
